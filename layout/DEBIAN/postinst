#!/bin/sh

if [ "$1" = "configure" ]; then
    if [ -x /var/jb/usr/bin/killall ]; then
        /var/jb/usr/bin/killall -9 callservicesd 2>/dev/null || true
    elif [ -x /usr/bin/killall ]; then
        /usr/bin/killall -9 callservicesd 2>/dev/null || true
    fi

    LAUNCHCTL="/bin/launchctl"
    if [ ! -x "$LAUNCHCTL" ] && [ -x /var/jb/bin/launchctl ]; then
        LAUNCHCTL="/var/jb/bin/launchctl"
    fi

    if [ -x "$LAUNCHCTL" ]; then
        "$LAUNCHCTL" bootout system/com.551.watusischeduledmsgfix.daemon 2>/dev/null || true
        "$LAUNCHCTL" bootstrap system /var/jb/Library/LaunchDaemons/com.551.watusischeduledmsgfix.daemon.plist 2>/dev/null || true
        "$LAUNCHCTL" kickstart -k system/com.551.watusischeduledmsgfix.daemon 2>/dev/null || true
    fi
fi

exit 0
